--- /dev/null
+++ b/apps/api/src/routes/field-definitions.test.ts
@@ -0,0 +1,74 @@
+import { describe, it, expect, beforeEach } from 'vitest';
+import { buildApp } from '../index';
+import { seedAdmin, seedViewer, authHeader } from '../../test/fixtures';
+
+describe('GET /field-definitions', () => {
+  it('returns the definitions ordered by key', async () => {
+    const app = buildApp();
+    const res = await app.inject({
+      method: 'GET',
+      url: '/api/field-definitions',
+      headers: authHeader(await seedViewer()),
+    });
+    expect(res.statusCode).toBe(200);
+    expect(res.json().map((d: any) => d.key)).toEqual(['budget', 'source']);
+  });
+
+  it('401s anonymously', async () => {
+    const app = buildApp();
+    const res = await app.inject({ method: 'GET', url: '/api/field-definitions' });
+    expect(res.statusCode).toBe(401);
+  });
+});
+
+describe('POST /field-definitions', () => {
+  it('creates and returns 201', async () => {
+    const app = buildApp();
+    const res = await app.inject({
+      method: 'POST',
+      url: '/api/field-definitions',
+      headers: authHeader(await seedAdmin()),
+      payload: { key: 'region', label: 'Region', type: 'text', options: null, requiredAtStages: [] },
+    });
+    expect(res.statusCode).toBe(201);
+    expect(res.json().key).toBe('region');
+  });
+
+  it('rejects options on a non-select field', async () => {
+    const app = buildApp();
+    const res = await app.inject({
+      method: 'POST',
+      url: '/api/field-definitions',
+      headers: authHeader(await seedAdmin()),
+      payload: { key: 'x', label: 'X', type: 'text', options: ['a'], requiredAtStages: [] },
+    });
+    expect(res.statusCode).toBe(400);
+  });
+
+  it('403s for a viewer', async () => {
+    const app = buildApp();
+    const res = await app.inject({
+      method: 'POST',
+      url: '/api/field-definitions',
+      headers: authHeader(await seedViewer()),
+      payload: { key: 'region', label: 'Region', type: 'text', options: null, requiredAtStages: [] },
+    });
+    expect(res.statusCode).toBe(403);
+  });
+});
+
+describe('PATCH /field-definitions/:id', () => {
+  it('updates the label', async () => {
+    const app = buildApp();
+    const { id } = await seedDefinition({ key: 'budget', label: 'Budget' });
+    const res = await app.inject({
+      method: 'PATCH',
+      url: `/api/field-definitions/${id}`,
+      headers: authHeader(await seedAdmin()),
+      payload: { label: 'Deal budget' },
+    });
+    expect(res.statusCode).toBe(200);
+    expect(res.json().label).toBe('Deal budget');
+  });
+
+  it('404s for an unknown id', async () => {
+    const app = buildApp();
+    const res = await app.inject({
+      method: 'PATCH',
+      url: '/api/field-definitions/00000000-0000-0000-0000-000000000000',
+      headers: authHeader(await seedAdmin()),
+      payload: { label: 'x' },
+    });
+    expect(res.statusCode).toBe(404);
+  });
+});

+import type { FastifyInstance } from 'fastify';
+import { CreateFieldDefinition, UpdateFieldDefinition } from '@app/contracts/field';
+import { requirePermission } from '../auth/permissions';
+import {
+  listDefinitions,
+  createDefinition,
+  updateDefinition,
+} from '../services/field-definition';
+
+export async function fieldDefinitionRoutes(app: FastifyInstance) {
+  app.get(
+    '/field-definitions',
+    { preHandler: requirePermission('field_config.read') },
+    async () => {
+      return listDefinitions();
+    }
+  );
+
+  app.post(
+    '/field-definitions',
+    { preHandler: requirePermission('field_config.write') },
+    async (req, reply) => {
+      const input = CreateFieldDefinition.parse(req.body);
+      const row = await createDefinition(input);
+      return reply.code(201).send(row);
+    }
+  );
+
+  app.patch<{ Params: { id: string } }>(
+    '/field-definitions/:id',
+    { preHandler: requirePermission('field_config.write') },
+    async (req) => {
+      const input = UpdateFieldDefinition.parse(req.body);
+      return updateDefinition(req.params.id, input);
+    }
+  );
+}


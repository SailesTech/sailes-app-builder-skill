// Copy to a NEW repo as .claude/settings.json (strip these // comments — JSON has no comments).
// The Claude Code harness guardrails: the mechanical backstop for the AGENTS.md Hard Safety Rules.
// Adapt the command patterns to the repo's actual package scripts. Two keys: "permissions" + "hooks".
//
// "permissions.allow"  — verify commands run without a prompt (fast inner loop). It includes
//                        git add/commit/log: every writing role is MANDATED to commit in its own
//                        worktree (that commit is its declaration the task is finished), and a
//                        mandate the permission layer prompts on is a mandate that fails. Measured
//                        2026-08-01: `docs-author` was blocked twice, in both command forms, and
//                        the lead had to commit the artifacts for it.
// "permissions.deny"   — the protected surface: PRODUCTION secrets, prod migrate/deploy,
//                        force-push, applied migrations. Note what is NOT here: the local `.env`.
//                        Env is tiered by risk, not by filename — see the guard script's comment.
//                        `.env.example` (keys, committed) and `.env` (local values, gitignored)
//                        are the agent's; `.env.production*`/`.env.staging*` and key material are
//                        not, and by `sailes-hosting` doctrine belong in the platform, not a file.
// "hooks.SessionStart" — inject STATE.md so "read at session start" is enforced, not remembered;
//                        warn when the local `.env` carries production markers.
// "hooks.PreToolUse"   — block edits to protected paths (applied migrations, implemented specs,
//                        lockfiles) AND protected COMMANDS. The matcher must include `Bash`:
//                        until 1.25.1 it read `Edit|Write`, so the guard's entire command surface
//                        (`reset --hard`, shell redirects into protected files) never executed in
//                        a Claude repo while the script's own comments claimed it did. The Codex
//                        twin had the `Bash` matcher all along — the two configs disagreed.
//
// Hook commands below are illustrative shell one-liners; move non-trivial logic into
// .claude/hooks/*.sh and call the script here. See Claude Code docs for the hook JSON contract
// (a PreToolUse hook that prints to stderr and exits non-zero blocks the tool call).
//
// CODEX TWIN: generate .codex/config.toml alongside this file (see codex-config-template.md).
// Codex uses the SAME hook contract (stdin JSON + exit-2-to-block + SessionStart stdout→context),
// so the .claude/hooks/*.sh scripts are SHARED — one copy, referenced by both harness configs.
// The permissions.allow/deny model below maps to Codex sandbox_mode + approval_policy + a Bash
// PreToolUse guard. A repo is "Codex-ready" only when BOTH configs exist and point at the scripts.
{
  "permissions": {
    "allow": [
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm db:generate:*)",
      "Bash(graphify:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(./.env.production)",
      "Read(./.env.production.*)",
      "Read(./.env.prod)",
      "Read(./.env.prod.*)",
      "Read(./.env.staging)",
      "Read(./.env.staging.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Edit(./.env.production)",
      "Edit(./.env.production.*)",
      "Edit(./.env.prod)",
      "Edit(./.env.prod.*)",
      "Edit(./.env.staging)",
      "Edit(./.env.staging.*)",
      "Edit(./packages/db/migrations/**)",
      "Edit(./.ai/specs/implemented/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(pnpm db:migrate:prod:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-protected-paths.sh"
          }
        ]
      }
    ]
  }
}

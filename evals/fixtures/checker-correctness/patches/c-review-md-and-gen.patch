   return mine.slice(offset, offset + pageSize - 1);
 }
 
-module.exports = { createNote, getNote, archiveNote, listNotes };
+/** Notes whose title contains `term`, case-insensitively. */
+function searchNotes(user, term) {
+  const needle = term.toLowerCase();
+  return db.notes.listAll().filter((n) => n.title.toLowerCase().includes(needle));
+}
+
+module.exports = { createNote, getNote, archiveNote, listNotes, searchNotes };

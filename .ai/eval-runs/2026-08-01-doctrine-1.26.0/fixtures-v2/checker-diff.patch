+++ b/packages/contracts/src/field.ts
@@ -0,0 +1,38 @@
+import { z } from 'zod';
+
+export const FieldType = z.enum(['text', 'number', 'select', 'date']);
+
+export const FieldDefinition = z.object({
+  id: z.string().uuid(),
+  key: z.string().min(1).max(64),
+  label: z.string().min(1),
+  type: FieldType,
+  options: z.array(z.string()).nullable(),
+  requiredAtStages: z.array(z.string()),
+  createdAt: z.string().datetime(),
+});
+export type FieldDefinition = z.infer<typeof FieldDefinition>;
+
+export const CreateFieldDefinition = FieldDefinition.omit({
+  id: true,
+  createdAt: true,
+});
+export type CreateFieldDefinition = z.infer<typeof CreateFieldDefinition>;
+
+export const UpdateFieldDefinition = CreateFieldDefinition.partial().omit({ key: true });
+export type UpdateFieldDefinition = z.infer<typeof UpdateFieldDefinition>;
+

diff --git a/apps/api/src/services/field-definition.ts b/apps/api/src/services/field-definition.ts
new file mode 100644
--- /dev/null
+++ b/apps/api/src/services/field-definition.ts
@@ -0,0 +1,52 @@
+import { eq } from 'drizzle-orm';
+import type { CreateFieldDefinition, UpdateFieldDefinition } from '@app/contracts/field';
+import { db } from '../db';
+import { fieldDefinition } from '@app/db/schema/field-definition';
+
+export async function listDefinitions() {
+  return db.select().from(fieldDefinition).orderBy(fieldDefinition.key);
+}
+
+export async function createDefinition(input: CreateFieldDefinition) {
+  if (input.type !== 'select' && input.options !== null) {
+    throw new BadRequest('options are only valid for select fields');
+  }
+  const [row] = await db.insert(fieldDefinition).values(input).returning();
+  return row;
+}
+
+export async function updateDefinition(id: string, input: UpdateFieldDefinition) {
+  const [row] = await db
+    .update(fieldDefinition)
+    .set(input)
+    .where(eq(fieldDefinition.id, id))
+    .returning();
+  if (!row) throw new NotFound('field definition');
+  return row;
+}

diff --git a/apps/api/src/routes/field-definitions.ts b/apps/api/src/routes/field-definitions.ts

@@ -37,10 +37,13 @@ function archiveNote(user, noteId) {
 /**
  * The caller's own notes, newest last.
  * @param {{ id: string, tenantId: string }} user
- * @param {{ page?: number, pageSize?: number }} opts  page is 1-based
+ * @param {{ page?: number, pageSize?: number, includeArchived?: boolean }} opts  page is 1-based
  */
-function listNotes(user, { page = 1, pageSize = 20 } = {}) {
-  const mine = db.notes.listByTenant(user.tenantId).filter((n) => n.ownerId === user.id);
+function listNotes(user, { page = 1, pageSize = 20, includeArchived = false } = {}) {
+  const mine = db.notes
+    .listByTenant(user.tenantId)
+    .filter((n) => n.ownerId === user.id)
+    .filter((n) => includeArchived || n.archivedAt === null);
   const offset = (page - 1) * pageSize;
   return mine.slice(offset, offset + pageSize - 1);
 }

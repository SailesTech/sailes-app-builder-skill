{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "How Doctrine Becomes Deployed Behavior",
    "subtitle": "Sailes app-builder framework: brief to approved spec to gated release to every machine's sessions to memory",
    "output": "docs/architecture/dataflow.html",
    "quality_profile": "showcase",
    "viewBox": [1080, 800]
  },
  "stages": [
    { "label": "Human & Brief" },
    { "label": "Specification" },
    { "label": "Branch: Implement & Test" },
    { "label": "Gate & Release" },
    { "label": "Deployed & Remembered" }
  ],
  "nodes": [
    { "id": "human-brief", "type": "external", "label": "Human Brief", "sublabel": "problem + job to be done", "stage": 0, "row": 2, "tag": "AGENTS.md HUMAN" },
    { "id": "ai-briefs", "type": "database", "label": ".ai/briefs", "sublabel": "brief + decisions ledger", "stage": 1, "row": 0, "tag": "brief" },
    { "id": "ai-specs", "type": "database", "label": ".ai/specs", "sublabel": "draft → approved (human gate)", "stage": 1, "row": 2, "tag": "SPEC gate" },
    { "id": "npm-test-validators", "type": "backend", "label": "npm test", "sublabel": "hooks + TOML + frontmatter + release hygiene", "stage": 2, "row": 0, "tag": "deterministic" },
    { "id": "implementation-branch", "type": "backend", "label": "Feature Branch", "sublabel": "be-dev / fe-dev implement, each in own worktree", "stage": 2, "row": 2, "tag": "lead cherry-picks, not main" },
    { "id": "evals-scenarios", "type": "backend", "label": "Eval Scenarios", "sublabel": "evals/ protected-behavior files", "stage": 2, "row": 4, "tag": "TDD-for-skills" },
    { "id": "main-branch", "type": "cloud", "label": "main", "sublabel": "production branch", "stage": 3, "row": 0, "tag": "live deploy" },
    { "id": "changelog-stamps", "type": "database", "label": "Release Stamps", "sublabel": "CHANGELOG + five version stamps", "stage": 3, "row": 2, "tag": "release" },
    { "id": "eval-verdicts", "type": "backend", "label": "Eval Verdicts", "sublabel": "fresh subagent PASS / FAIL", "stage": 3, "row": 4, "tag": "model behavior" },
    { "id": "marketplace-autoupdate", "type": "cloud", "label": "Marketplace", "sublabel": "plugin, autoUpdate: true", "stage": 4, "row": 0, "tag": "~/.claude/plugins" },
    { "id": "machine-sessions", "type": "frontend", "label": "All Machines", "sublabel": "every machine running the plugin", "stage": 4, "row": 2, "tag": "runtime" },
    { "id": "memory-files", "type": "database", "label": "Session Memory", "sublabel": "STATE.md, lessons.md, backlog.md", "stage": 4, "row": 4, "tag": ".ai/ memory" }
  ],
  "flows": [
    { "id": "brief-intake", "from": "human-brief", "to": "ai-briefs", "label": "problem + job", "classification": "intake", "variant": "emphasis", "labelAt": [130, 300] },
    { "id": "brief-to-spec", "from": "ai-briefs", "to": "ai-specs", "label": "brief becomes draft spec", "classification": "spec-writing-template", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelAt": [315, 271] },
    { "id": "spec-to-branch", "from": "ai-specs", "to": "implementation-branch", "label": "approved spec", "classification": "SPEC gate cleared", "variant": "emphasis", "fromSide": "right", "toSide": "left", "route": "straight" },
    { "id": "branch-to-tests", "from": "implementation-branch", "to": "npm-test-validators", "label": "diff", "classification": "deterministic checks", "variant": "emphasis", "fromSide": "top", "toSide": "bottom", "route": "straight", "labelAt": [530, 271] },
    { "id": "branch-to-evals", "from": "implementation-branch", "to": "evals-scenarios", "label": "protected behaviors", "classification": "written before/alongside code", "variant": "default", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelAt": [530, 499] },
    { "id": "evals-to-verdicts", "from": "evals-scenarios", "to": "eval-verdicts", "label": "dispatch", "classification": "fresh-subagent judged", "variant": "default", "fromSide": "right", "toSide": "left", "route": "straight", "labelAt": [638, 545] },
    { "id": "tests-to-release", "from": "npm-test-validators", "to": "changelog-stamps", "label": "green suite", "classification": "release hygiene check", "variant": "emphasis", "fromSide": "right", "toSide": "top" },
    { "id": "verdicts-to-release", "from": "eval-verdicts", "to": "changelog-stamps", "label": "PASS verdicts", "classification": "gate evidence", "variant": "default", "fromSide": "top", "toSide": "bottom", "route": "straight", "labelAt": [745, 499] },
    { "id": "release-to-main", "from": "changelog-stamps", "to": "main-branch", "label": "push", "classification": "live deploy trigger", "variant": "emphasis", "fromSide": "top", "toSide": "bottom", "route": "straight", "labelAt": [745, 300] },
    { "id": "main-to-marketplace", "from": "main-branch", "to": "marketplace-autoupdate", "label": "tracks main", "classification": "autoUpdate: true", "variant": "emphasis", "fromSide": "right", "toSide": "left", "route": "straight" },
    { "id": "marketplace-to-sessions", "from": "marketplace-autoupdate", "to": "machine-sessions", "label": "skills / agents / hooks", "classification": "plugin sync, no install step", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelAt": [960, 271] },
    { "id": "sessions-to-memory", "from": "machine-sessions", "to": "memory-files", "label": "STATE / lessons / backlog", "classification": "session writes memory", "variant": "default", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelAt": [960, 499] },
    { "id": "memory-loop", "from": "memory-files", "to": "ai-briefs", "label": "read before next brief", "classification": "memory loop", "variant": "dashed", "fromSide": "bottom", "toSide": "left", "via": [[960, 700], [219, 700], [219, 157]], "labelAt": [590, 700] }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Path — Doctrine to Deploy",
      "items": [
        "An approved spec unlocks the branch (AGENTS.md SPEC gate) — nothing lands before it",
        "Every writer runs in its own worktree; it commits there, never to the shared branch, and never pushes — the lead cherry-picks finished work in (agent-team-structure.md § Isolation)",
        "A push to main is the deploy — the marketplace plugin auto-updates every machine that ran enable-plugin.sh",
        "There is no post-merge install step; autoUpdate: true does the sync (AGENTS.md §Release)"
      ]
    },
    {
      "dot": "violet",
      "title": "Two Kinds of Verification",
      "items": [
        "npm test proves deterministic behavior: hook tests, TOML/frontmatter validators, release hygiene (five stamps + CHANGELOG heading)",
        "evals/ prove model behavior: scenarios dispatched to fresh subagents, judged PASS/FAIL/STALE by evals/harness/eval-status.js",
        "AGENTS.md: a green test says nothing about whether the instruction lands — the two gates never substitute for each other"
      ]
    },
    {
      "dot": "amber",
      "title": "The Memory Loop",
      "items": [
        ".ai/ is memory, not scratch: STATE.md, lessons.md and backlog.md are read by the next session (AGENTS.md §Hard safety rules)",
        "The next session reads that memory before writing its own brief, closing the loop back into .ai/briefs",
        "Five version stamps (VERSION, package.json, plugin.json, marketplace.json, AGENTS.md Framework-Version) gate every release together"
      ]
    }
  ]
}
